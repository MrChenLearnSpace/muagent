{
  "MuAgents": {
    "Agent": {
      "MaxToolIterations": 12,
      "ToolTimeoutSeconds": 60,
      "MaxConcurrency": 4,
      "MaxResultCharacters": 48000
    },
    "CommandExecution": {
      "ApprovalMode": "RequireApproval",
      "AllowedCommands": [],
      "MaxExecutionSeconds": 120,
      "ApprovalTimeoutSeconds": 120,
      "MaxOutputCharacters": 48000
    },
    "Context": {
      "MaxContextTokens": 128000,
      "ReservedOutputTokens": 4096,
      "CompactionRatio": 0.6667,
      "SafetyMarginTokens": 1024,
      "RecentTurnsToKeep": 4
    },
    "Persistence": {
      "ConnectionString": "Data Source=data/muagents.db"
    },
    "Content": {
      "MaxFileBytes": 26214400,
      "PdfTextExecutable": "pdftotext",
      "PdfRenderExecutable": "pdftoppm",
      "ProcessTimeoutSeconds": 120,
      "Images": {
        "MaxImageBytes": 10485760,
        "MaxPixels": 40000000,
        "AllowedRoots": []
      },
      "FileTool": {
        "WorkspaceRoots": [],
        "MaxCharacters": 100000,
        "MaxPages": 100,
        "EnableOcr": true
      },
      "Ocr": {
        "Executable": "tesseract",
        "TimeoutSeconds": 60,
        "MaxOutputCharacters": 200000
      }
    },
    "Skills": {
      "Directories": [ "skills" ],
      "ScriptPolicy": "RequireApproval",
      "AllowedRuntimes": [ "dotnet", "python", "node", "pwsh", "bash" ],
      "ScriptTimeoutSeconds": 60
    },
    "Web": {
      "AgentMaySearch": true,
      "TimeoutSeconds": 20,
      "MaxRedirects": 5,
      "MaxResponseBytes": 2097152
    },
    "Mcp": {
      "ToolCacheSeconds": 60,
      "Servers": []
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
